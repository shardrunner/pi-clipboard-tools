{
  "name": "pi-clipboard-tools",
  "version": "0.1.0",
  "description": "Copy shell commands and user input from the active Pi session branch.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "keywords": ["pi-package", "pi", "clipboard"],
  "files": ["index.ts", "README.md", "LICENSE"],
  "pi": { "extensions": ["./index.ts"] },
  "scripts": {
    "test": "node --test *.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "peerDependencies": { "@earendil-works/pi-coding-agent": "*" },
  "overrides": {
    "@earendil-works/pi-coding-agent": {
      "brace-expansion": "5.0.12",
      "undici": "8.12.3"
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@types/node": "^24.0.0",
    "typescript": "~5.9.3"
  }
}
